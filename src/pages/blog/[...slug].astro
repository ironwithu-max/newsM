---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import { categoryLabel, COMPANY } from '../../consts';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, category, pubDate, updatedDate, tags } = post.data;
const isRealestate = category === 'realestate';

const dateStr = pubDate.toLocaleDateString('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title} description={description} article={true}>
  <article>
    <header class="post-head">
      <a class="cat" href={isRealestate ? '/realestate' : `/category/${category}/`}>{isRealestate ? '생활정보' : categoryLabel(category)}</a>
      <h1>{title}</h1>
      <div class="meta">
        <time datetime={pubDate.toISOString()}>{dateStr}</time>
        {updatedDate && <span> · 업데이트됨</span>}
      </div>
    </header>

    <AdSlot slot="5077112561" label="본문 상단 광고" />

    <div class="prose">
      <Content />
    </div>

    <AdSlot slot="5077112561" label="본문 하단 광고" />

    {
      tags.length > 0 && (
        <div class="tags">
          {tags.map((t) => (
            <span class="tag">#{t}</span>
          ))}
        </div>
      )
    }

    {
      isRealestate && (
        <div class="re-cta">
          <p><strong>입주 전 리모델링, 미리 견적을 받아 보세요.</strong> 아파트 구조와 예산에 맞춰 {COMPANY.brandName}이 설계부터 시공까지 안내해 드립니다.</p>
          <a href="/consult">상담문의 하기 →</a>
        </div>
      )
    }

    <p class="back"><a href={isRealestate ? '/realestate' : '/blog/'}>← {isRealestate ? '생활정보 목록' : '전체 글 목록'}</a></p>
  </article>
</BaseLayout>

<style>
  .post-head {
    margin-bottom: 1.5rem;
  }
  .post-head h1 {
    font-size: 1.8rem;
    margin: 0.4rem 0;
  }
  .cat {
    display: inline-block;
    font-size: 0.8rem;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    text-decoration: none;
  }
  .meta {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .tags {
    margin: 1.5rem 0;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .tag {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .back {
    margin-top: 2rem;
  }
  .re-cta {
    margin: 2rem 0 0;
    padding: 1.2rem 1.4rem;
    border-radius: 14px;
    background: var(--accent-soft);
    border-left: 4px solid var(--accent);
  }
  .re-cta p {
    margin: 0 0 0.6rem;
  }
  .re-cta a {
    color: var(--accent);
    font-weight: 700;
    text-decoration: none;
  }
</style>

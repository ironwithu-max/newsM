---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COMPANY } from '../consts';

const history = [
  { year: '2024', text: '㈜미남테크 전문건설 실내건축 설립' },
  { year: '2023', text: '여성기업 등록' },
  { year: '2021', text: '㈜미남테크 전기공사업 법인설립 · 전기공사업 면허취득' },
  { year: '2019', text: '위드디자인 → 미남디자인 변경 법인설립 · 전문건설 실내건축공사업 면허취득' },
  { year: '2015', text: '위드디자인 설립' },
];
---

<BaseLayout title="회사소개" description="㈜미남테크 미남건축디자인 회사소개 — 실내건축·전기공사 전문 설계시공">
  <div class="prose">
    <h1>회사소개</h1>
    <p>
      <strong>{COMPANY.legalName}</strong>(<strong>{COMPANY.brandName}</strong>)은
      우수한 기술인력과 기본에 충실한 책임시공을 바탕으로, 건축물이 단순한 공간을
      넘어 삶의 질을 높이고 도시의 아름다움에 기여하도록 노력하는 실내건축·전기공사
      전문 설계시공 업체입니다.
    </p>
    <blockquote>{COMPANY.slogan} — {COMPANY.tagline}</blockquote>

    <h2>회사 개요</h2>
    <table>
      <tbody>
        <tr><th>회사명</th><td>{COMPANY.legalName} ({COMPANY.brandName})</td></tr>
        <tr><th>대표이사</th><td>{COMPANY.ceo}</td></tr>
        <tr><th>설립일</th><td>{COMPANY.founded}</td></tr>
        <tr><th>직원수</th><td>{COMPANY.staff}</td></tr>
        <tr><th>사업분야</th><td>{COMPANY.fields}</td></tr>
        <tr><th>보유면허</th><td>{COMPANY.licenses}</td></tr>
        <tr><th>본사</th><td>{COMPANY.hqAddress}</td></tr>
        <tr><th>지사</th><td>{COMPANY.branchAddress}</td></tr>
        <tr><th>연락처</th><td>{COMPANY.tel} · {COMPANY.email}</td></tr>
      </tbody>
    </table>

    <h2>연혁</h2>
    <ul>
      {history.map((h) => <li><strong>{h.year}</strong> — {h.text}</li>)}
    </ul>

    <h2>사업분야</h2>
    <ul>
      <li><strong>건축공사</strong> — 계획부터 시공, 감리까지 건축공정 전 과정 책임</li>
      <li><strong>실내건축</strong> — 심미성과 기능성이 조화를 이루는 공간 설계·시공</li>
      <li><strong>전기공사</strong> — 전기배선·조명·설비 설치 및 유지보수</li>
      <li><strong>전기차 충전 인프라</strong> — 충전소 설계·설치·관리 토털 솔루션</li>
    </ul>

    <h2>상담·문의</h2>
    <p>
      공간 계획을 준비 중이시라면 편하게 문의해 주세요.
      <a href={`tel:${COMPANY.tel}`}>{COMPANY.tel}</a> 또는
      <a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a>,
      <a href="/#contact">상담문의 폼</a>을 이용하실 수 있습니다.
    </p>
  </div>
</BaseLayout>

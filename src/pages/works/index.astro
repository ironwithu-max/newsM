---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../../components/WorkCard.astro';
import { COMPANY } from '../../consts';
import { listAllPublished, mixWorks, groupOf, boardOf, WORK_GROUPS, ARCH_GROUPS, BOARDS, type WorkGroup, type WorkBoard, toCard, FALLBACK_WORKS, PUBLIC_CACHE } from '../../lib/works';

const PER_PAGE = 12;
const boardParam = Astro.url.searchParams.get('board');
const board: WorkBoard = boardParam === 'arch' ? 'arch' : 'interior';
const GROUPS = board === 'arch' ? ARCH_GROUPS : WORK_GROUPS;
const typeParam = Astro.url.searchParams.get('type') || '';
const type = (GROUPS.some((g) => g.key === typeParam) ? typeParam : '') as WorkGroup | '';
const page = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10) || 1);

// 전체: 아파트·상업공간·학원·주간보호가 번갈아 나오게 섞기 / 종류 선택: 그 종류만 (정렬 순서 → 최신순)
const everything = await listAllPublished();
const all = everything.filter((w) => boardOf(w) === board);
const boardCount = (b: WorkBoard) => everything.filter((w) => boardOf(w) === b).length;
const filtered = type ? all.filter((w) => groupOf(w) === type) : mixWorks(all);
const total = filtered.length;
const pages = Math.max(1, Math.ceil(total / PER_PAGE));
const items = filtered.slice((page - 1) * PER_PAGE, page * PER_PAGE);

// 실제 글이 있는 종류만 버튼으로
const groups = GROUPS.filter((g) => all.some((w) => groupOf(w) === g.key));
const typeLabel = GROUPS.find((g) => g.key === type)?.label || '';
const boardLabel = BOARDS.find((b) => b.key === board)!.label;

const useFallback = everything.length === 0;
const cards = useFallback ? FALLBACK_WORKS : items.map(toCard);

const qs = (p: { tag?: string; page?: number }) => {
  const s = new URLSearchParams();
  if (board === 'arch') s.set('board', 'arch');
  if (p.tag) s.set('type', p.tag);
  if (p.page && p.page > 1) s.set('page', String(p.page));
  const q = s.toString();
  return q ? `/works?${q}` : '/works';
};

Astro.response.headers.set('Cache-Control', PUBLIC_CACHE);
---

<BaseLayout
  title={`${typeLabel || boardLabel} 시공사례`}
  description={`${COMPANY.brandName}(${COMPANY.legalName})의 실내건축·리모델링·전기공사 시공사례 모음. 주거공간, 상업공간, 전시·쇼룸 등 실제 현장 사진과 시공 내용을 확인하세요.`}
  wide={true}
>
  <section class="whero">
    <div class="whero__wrap">
      <div class="whero__main">
        <p class="crumb"><a href="/">홈</a> <span>/</span> 시공사례</p>
        <p class="whero__eyebrow">PORTFOLIO</p>
        <h1 class="whero__title">시공사례</h1>
        <p class="whero__lead">미남건축디자인이 직접 설계·시공한 현장을 소개합니다.</p>
      </div>
      <div class="whero__brand">
        <span class="whero__brand-name">미남건축디자인</span>
        <span class="whero__brand-sub">건축시공 · 실내건축 · 전기공사</span>
      </div>
    </div>
  </section>

  <section class="wsec">
    <div class="wwrap">
      {
        <nav class="boards" aria-label="게시판">
          {BOARDS.map((b) => (
            <a href={b.key === 'arch' ? '/works?board=arch' : '/works'} class:list={['board', { 'is-on': board === b.key }]}>
              {b.label} <span>{boardCount(b.key)}</span>
            </a>
          ))}
        </nav>
      }
      {board === 'arch' && (
        <p class="arch-note">신축·증축 등 건축공사는 협력사 <a href="/partners/hiwon">하이원종합건설㈜</a>와 함께 진행합니다. ‘협력사 시공’ 표시는 협력사의 시공 사례입니다.</p>
      )}
      {
        groups.length > 0 && (
          <nav class="filter" aria-label="분류">
            <a href={qs({})} class:list={['chip', { 'is-on': !type }]}>전체 {all.length}</a>
            {groups.map((g) => (
              <a href={qs({ tag: g.key })} class:list={['chip', { 'is-on': type === g.key }]}>{g.label}</a>
            ))}
          </nav>
        )
      }

      {
        cards.length === 0 ? (
          <p class="empty">해당 분류의 시공사례가 아직 없습니다. <a href="/works">전체 보기</a></p>
        ) : (
          <div class="grid">
            {cards.map((w) => <WorkCard work={w} />)}
          </div>
        )
      }

      {
        pages > 1 && (
          <nav class="pager" aria-label="페이지">
            {page > 1 && <a href={qs({ tag: type, page: page - 1 })}>‹ 이전</a>}
            {Array.from({ length: pages }, (_, i) => i + 1).map((n) =>
              n === page ? <span class="is-on">{n}</span> : <a href={qs({ tag: type, page: n })}>{n}</a>
            )}
            {page < pages && <a href={qs({ tag: type, page: page + 1 })}>다음 ›</a>}
          </nav>
        )
      }

      <div class="cta">
        <p>원하시는 공간이 있으신가요? 현장 상황에 맞춰 설계부터 시공까지 제안해 드립니다.</p>
        <div class="cta__btns">
          <a href="/#contact" class="btn btn--primary">상담문의 하기</a>
          <a href={`tel:${COMPANY.tel}`} class="btn btn--line">☎ {COMPANY.tel}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .whero {
    background:
      radial-gradient(900px 400px at 85% -20%, rgba(163, 93, 58, 0.3), transparent 60%),
      var(--ink);
    color: #ece5db;
  }
  .whero__wrap,
  .wwrap {
    max-width: 1080px;
    margin: 0 auto;
    padding: 2.6rem 1.2rem 3rem;
  }
  .crumb {
    font-size: 0.85rem;
    color: #a89f92;
    margin: 0 0 1.2rem;
  }
  .crumb a {
    color: #cdc3b4;
    text-decoration: none;
  }
  .crumb a:hover {
    color: #fff;
  }
  .crumb span {
    margin: 0 0.35rem;
    opacity: 0.5;
  }
  .whero__eyebrow {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 700;
    color: #d9a985;
    letter-spacing: 0.12em;
  }
  .whero__title {
    margin: 0.4rem 0 0.5rem;
    font-size: clamp(1.9rem, 5vw, 2.6rem);
    color: #fff;
    letter-spacing: -0.02em;
  }
  .whero__lead {
    margin: 0;
    color: #cdc3b4;
  }
  /* 배너 우측 상호·슬로건 (헤더에서 이동) */
  .whero__wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .whero__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.35rem;
    padding-left: 1.5rem;
    border-left: 1px solid rgba(236, 229, 219, 0.25);
    text-align: right;
    white-space: nowrap;
  }
  .whero__brand-name {
    font-size: clamp(1.2rem, 2.4vw, 1.6rem);
    font-weight: 800;
    color: #fff;
    letter-spacing: -0.01em;
  }
  .whero__brand-sub {
    font-size: 0.9rem;
    color: #d9a985;
  }
  @media (max-width: 640px) {
    .whero__wrap {
      flex-direction: column;
      align-items: flex-start;
    }
    .whero__brand {
      align-items: flex-start;
      padding: 0.9rem 0 0;
      border-left: none;
      border-top: 1px solid rgba(236, 229, 219, 0.25);
      text-align: left;
    }
  }
  .boards {
    display: flex;
    gap: 0.4rem;
    margin-bottom: 1rem;
    border-bottom: 2px solid var(--border);
  }
  .board {
    padding: 0.7rem 1.3rem;
    margin-bottom: -2px;
    border-bottom: 3px solid transparent;
    color: var(--muted);
    font-weight: 800;
    font-size: 1.05rem;
    text-decoration: none;
  }
  .board span {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--muted);
  }
  .board.is-on {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }
  .board.is-on span {
    color: var(--accent);
  }
  .arch-note {
    margin: 0 0 1rem;
    color: var(--muted);
    font-size: 0.92rem;
  }
  .arch-note a {
    color: var(--accent);
    font-weight: 700;
  }
  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.6rem;
  }
  .chip {
    padding: 0.4rem 0.95rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--fg);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .chip:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .chip.is-on {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.1rem;
  }
  .empty {
    color: var(--muted);
    padding: 2rem 0;
  }
  .pager {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 2.2rem 0 0;
  }
  .pager a,
  .pager span {
    min-width: 2.3rem;
    padding: 0.4rem 0.7rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    text-align: center;
    text-decoration: none;
    color: var(--fg);
    font-size: 0.9rem;
  }
  .pager a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .pager .is-on {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
    font-weight: 700;
  }
  .cta {
    margin-top: 3rem;
    padding: 1.6rem 1.8rem;
    border-radius: 16px;
    background: var(--bg-soft);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .cta p {
    margin: 0;
    font-weight: 600;
  }
  .cta__btns {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.4rem;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
    font-size: 0.95rem;
    border: 1px solid transparent;
  }
  .btn--primary {
    background: var(--accent);
    color: #fff;
  }
  .btn--line {
    border-color: var(--border);
    color: var(--fg);
    background: #fff;
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 520px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

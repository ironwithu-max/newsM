---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COMPANY } from '../consts';

const stats = [
  { num: '12+', label: '건축·인테리어 경력(년)' },
  { num: '350+', label: '주요 공사 프로젝트' },
  { num: '650+', label: '누적 계약 건수' },
  { num: '95%', label: '재의뢰·계약연장률' },
  { num: '100%', label: '프로젝트 완수율' },
];

const business = [
  {
    icon: '🏛️',
    tag: 'ARCHITECTURE',
    title: '건축공사',
    desc: '계획부터 시공, 감리에 이르기까지 건축공정의 전 과정을 책임집니다.',
    href: '/business/architecture',
  },
  {
    icon: '🛋️',
    tag: 'INTERIOR',
    title: '실내건축',
    desc: '현대적 디자인과 기술로 심미성과 기능성이 조화를 이루는 공간을 설계·시공합니다.',
    href: '/business/interior',
  },
  {
    icon: '💡',
    tag: 'ELECTRIC',
    title: '전기공사',
    desc: '전기배선·조명·설비 설치와 유지보수. 안정성과 효율성을 고려한 전기 시스템을 구축합니다.',
    href: '/business/electric',
  },
  {
    icon: '🔌',
    tag: 'EV CHARGING',
    title: '전기차 충전 인프라',
    desc: '충전소 설계부터 설치·관리까지, 전기차 충전에 필요한 토털 솔루션을 제공합니다.',
    href: '/business/ev-charging',
  },
];

const strengths = [
  {
    no: '01',
    title: '고객 맞춤형 디자인',
    desc: '고객의 독특한 요구와 조건에 맞는 설계 솔루션을 제공하여, 기대를 충족시키는 동시에 새로운 디자인 가치를 제안합니다.',
  },
  {
    no: '02',
    title: '올인원 토탈 서비스',
    desc: '기획부터 시공, 완공 후 서비스, 안전 및 품질 관리까지 필요한 모든 과정을 끝까지 책임집니다.',
  },
  {
    no: '03',
    title: '높은 신뢰성과 책임감',
    desc: '설립 이후 진행된 모든 프로젝트를 중도 중단 없이 완수 — 프로젝트 완수율 100%를 지켜왔습니다.',
  },
];

const works = [
  { img: '/images/works/apt-living-kitchen.webp', label: '아파트 거실·주방 리모델링', tag: '주거공간' },
  { img: '/images/works/rehouse-showroom.webp', label: '한샘리하우스 전시관', tag: '전시·쇼룸' },
  { img: '/images/works/winebar.webp', label: '어비스 와인바', tag: '상업공간' },
  { img: '/images/works/white-kitchen.webp', label: '화이트 주방 리모델링', tag: '주거공간' },
  { img: '/images/works/kitchen-showroom.webp', label: '주방 쇼룸 시공', tag: '전시·쇼룸' },
  { img: '/images/works/chicken-pub.webp', label: '청춘튀겨 치킨펍', tag: '상업공간' },
  { img: '/images/works/bathroom.webp', label: '욕실 리모델링', tag: '욕실 리모델링' },
  { img: '/images/works/entrance.webp', label: '현관·중문 시공', tag: '주거공간' },
];

const process = [
  { no: 1, title: '기획', desc: '의뢰를 받아 공사의 목표와 큰 방향을 정합니다.' },
  { no: 2, title: '현장조사', desc: '현장 상황을 파악하고 실측 작업을 수행합니다.' },
  { no: 3, title: '계획설계', desc: '공간 계획과 디자인 주요 개념을 설정합니다.' },
  { no: 4, title: '기본설계', desc: '설계 내용을 시각적으로 도식화해 전달합니다.' },
  { no: 5, title: '실시설계', desc: '도면·서류와 세부 사항을 전문적으로 검토합니다.' },
  { no: 6, title: '시공', desc: '품질이 계획대로 유지되는지 지속 확인합니다.' },
  { no: 7, title: '준공', desc: '정리 작업과 사용 전 최종 안전점검을 진행합니다.' },
];

const values = [
  {
    en: 'Architecture for People',
    ko: '사람을 위한 건축',
    desc: '공간을 만드는 사람과 누리는 사람을 함께 생각합니다.',
  },
  {
    en: 'Based on Teamwork',
    ko: '팀워크에 기반한 건축',
    desc: '각 분야 전문가가 긴밀히 협력해 창의적 결과물을 만듭니다.',
  },
  {
    en: 'By Excellence',
    ko: '탁월에 의한 건축',
    desc: '깊이 있는 이해와 최신 기술, 혁신적 디자인으로 최고를 지향합니다.',
  },
];

const spaceTypes = ['주거공간 (아파트·주택)', '상업공간 (카페·매장)', '사무공간·오피스', '전시·홍보관', '전기공사·충전 인프라', '기타 문의'];
---

<BaseLayout
  title="공간을 넘어선 아름다움을 시공합니다"
  description="㈜미남테크 미남건축디자인 — 실내건축·전기공사·전기차 충전 인프라 전문 설계시공. 김해·부산·경남 전역. 상담문의 1533-9820."
  wide={true}
>
  <!-- ───────── HERO ───────── -->
  <section class="hero">
    <div class="hero__wrap">
      <p class="hero__eyebrow">㈜미남테크 · 실내건축 · 전기공사 전문시공</p>
      <h1 class="hero__title">
        공간을 넘어선 <span class="hl">아름다움</span>을<br />시공합니다
      </h1>
      <p class="hero__sub">
        단순한 건물, 그 이상의 공간 설계를 제안합니다. 심도 높은 디자인과 탁월한
        기술력으로 심미성과 실용성을 겸비한 공간을 완성합니다.
      </p>
      <div class="hero__cta">
        <a href="#contact" class="btn btn--primary">상담문의 하기</a>
        <a href={`tel:${COMPANY.tel}`} class="btn btn--line">☎ {COMPANY.tel}</a>
      </div>
      <div class="hero__stats">
        {
          stats.map((s) => (
            <div class="hstat">
              <span class="hstat__num">{s.num}</span>
              <span class="hstat__label">{s.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ───────── 사업분야 ───────── -->
  <section id="business" class="sec">
    <div class="wrap">
      <p class="sec__eyebrow">BUSINESS</p>
      <h2 class="sec__title">주요 사업 분야</h2>
      <p class="sec__desc">
        건축부터 실내건축, 전기공사, 전기차 충전 인프라까지 — 공간에 필요한 모든
        과정을 한 곳에서 책임집니다.
      </p>
      <div class="biz-grid">
        {
          business.map((b) => (
            <a class="biz" href={b.href}>
              <span class="biz__icon">{b.icon}</span>
              <span class="biz__tag">{b.tag}</span>
              <h3 class="biz__title">{b.title}</h3>
              <p class="biz__desc">{b.desc}</p>
              <span class="biz__go">자세히 보기 →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ───────── 강점 ───────── -->
  <section class="sec sec--soft">
    <div class="wrap">
      <p class="sec__eyebrow">WHY MINAM</p>
      <h2 class="sec__title">수많은 기업이 미남을 선택하는 이유</h2>
      <div class="str-grid">
        {
          strengths.map((s) => (
            <article class="str">
              <span class="str__no">{s.no}</span>
              <h3 class="str__title">{s.title}</h3>
              <p class="str__desc">{s.desc}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ───────── 시공사례 ───────── -->
  <section id="works" class="sec">
    <div class="wrap">
      <p class="sec__eyebrow">PORTFOLIO</p>
      <h2 class="sec__title">주요 시공사례</h2>
      <p class="sec__desc">
        전시관·홍보관, 상업공간, 주거 리모델링, 관공서·학교까지 350건 이상의
        프로젝트를 수행했습니다.
      </p>
      <div class="work-grid">
        {
          works.map((w) => (
            <figure class="work">
              <img
                class="work__img"
                src={w.img}
                alt={w.label}
                width="1200"
                height="900"
                loading="lazy"
              />
              <figcaption class="work__cap">
                <span class="work__tag">{w.tag}</span>
                <span class="work__label">{w.label}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
      <p class="work-more">
        더 많은 시공사례는
        <a href={COMPANY.blog} target="_blank" rel="noopener">네이버 블로그</a>에서
        확인하실 수 있습니다.
      </p>
    </div>
  </section>

  <!-- ───────── 프로세스 ───────── -->
  <section class="sec sec--dark">
    <div class="wrap">
      <p class="sec__eyebrow sec__eyebrow--on">PROCESS</p>
      <h2 class="sec__title sec__title--on">설계부터 준공까지, 7단계 프로세스</h2>
      <ol class="proc">
        {
          process.map((p) => (
            <li class="proc__item">
              <span class="proc__no">{p.no}</span>
              <span class="proc__title">{p.title}</span>
              <span class="proc__desc">{p.desc}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ───────── 회사소개 ───────── -->
  <section id="about" class="sec sec--soft">
    <div class="wrap about">
      <div class="about__intro">
        <p class="sec__eyebrow">ABOUT</p>
        <h2 class="sec__title">미남건축디자인의 가치</h2>
        <p class="about__lead">
          ㈜미남테크는 우수한 기술인력과 기본에 충실한 책임시공을 바탕으로,
          건축물이 단순한 공간을 넘어 삶의 질을 높이고 도시의 아름다움에 기여하도록
          노력합니다.
        </p>
        <dl class="about__facts">
          <div><dt>회사명</dt><dd>{COMPANY.legalName} ({COMPANY.brandName})</dd></div>
          <div><dt>대표이사</dt><dd>{COMPANY.ceo}</dd></div>
          <div><dt>설립일</dt><dd>{COMPANY.founded}</dd></div>
          <div><dt>사업분야</dt><dd>{COMPANY.fields}</dd></div>
          <div><dt>보유면허</dt><dd>{COMPANY.licenses}</dd></div>
          <div><dt>소재지</dt><dd>{COMPANY.hqAddress}</dd></div>
        </dl>
      </div>
      <div class="about__values">
        {
          values.map((v) => (
            <div class="val">
              <span class="val__en">{v.en}</span>
              <h3 class="val__ko">{v.ko}</h3>
              <p class="val__desc">{v.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ───────── 상담문의 ───────── -->
  <section id="contact" class="sec">
    <div class="wrap contact">
      <div class="contact__info">
        <p class="sec__eyebrow">CONTACT</p>
        <h2 class="sec__title">공간을 계획 중이신가요?</h2>
        <p class="contact__lead">
          미남건축디자인이 기획부터 시공까지 함께합니다. 편하게 상담을 남겨
          주세요. 확인 후 빠르게 연락드리겠습니다.
        </p>
        <ul class="contact__list">
          <li><span>대표전화</span><a href={`tel:${COMPANY.tel}`}>{COMPANY.tel}</a></li>
          <li><span>이메일</span><a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a></li>
          <li><span>본사</span><em>{COMPANY.hqAddress}</em></li>
          <li><span>지사</span><em>{COMPANY.branchAddress}</em></li>
          <li><span>블로그</span><a href={COMPANY.blog} target="_blank" rel="noopener">blog.naver.com/withudesign</a></li>
        </ul>
      </div>

      <form class="contact__form" id="consultForm">
        <label class="fld">
          <span>이름</span>
          <input type="text" name="name" required placeholder="성함을 입력해 주세요" />
        </label>
        <label class="fld">
          <span>연락처</span>
          <input type="tel" name="phone" required placeholder="010-0000-0000" />
        </label>
        <label class="fld">
          <span>공간 유형</span>
          <select name="type">
            {spaceTypes.map((t) => <option value={t}>{t}</option>)}
          </select>
        </label>
        <label class="fld">
          <span>문의 내용</span>
          <textarea name="message" rows="4" placeholder="공간 위치·평형·희망 일정 등을 적어주시면 상담이 빨라집니다."></textarea>
        </label>
        <button type="submit" class="btn btn--primary btn--block">상담 신청하기</button>
        <p class="contact__note" id="formNote">
          * 신청 시 이메일 상담창이 열립니다. 급하신 경우 <a href={`tel:${COMPANY.tel}`}>{COMPANY.tel}</a>로 전화 주세요.
        </p>
      </form>
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ email: COMPANY.email }}>
  const form = document.getElementById('consultForm');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const f = new FormData(form);
      const name = (f.get('name') || '').toString().trim();
      const phone = (f.get('phone') || '').toString().trim();
      const type = (f.get('type') || '').toString();
      const message = (f.get('message') || '').toString().trim();
      const subject = `[상담문의] ${name} 님 (${type})`;
      const body =
        `이름: ${name}\n연락처: ${phone}\n공간 유형: ${type}\n\n문의 내용:\n${message}\n`;
      window.location.href =
        `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      const note = document.getElementById('formNote');
      if (note) note.textContent = '상담 신청이 접수되었습니다. 이메일 창에서 전송을 완료해 주세요. 감사합니다.';
    });
  }
</script>

<style>
  /* 공통 래퍼 */
  .wrap {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 1.2rem;
  }
  .sec {
    padding: 4rem 0;
  }
  .sec--soft {
    background: var(--bg-soft);
  }
  .sec__eyebrow {
    margin: 0 0 0.5rem;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: var(--accent);
  }
  .sec__eyebrow--on {
    color: #d9a985;
  }
  .sec__title {
    margin: 0 0 0.6rem;
    font-size: clamp(1.5rem, 4vw, 2rem);
    letter-spacing: -0.02em;
  }
  .sec__title--on {
    color: #fff;
  }
  .sec__desc {
    margin: 0 0 2rem;
    color: var(--muted);
    max-width: 44rem;
    font-size: 1.02rem;
  }
  .sec__desc em {
    font-style: normal;
    color: var(--accent);
    font-size: 0.92rem;
  }

  /* 버튼 */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    border-radius: 999px;
    padding: 0.8rem 1.5rem;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    border: 1.5px solid transparent;
    cursor: pointer;
    transition: opacity 0.15s, border-color 0.15s, color 0.15s, background 0.15s;
  }
  .btn--primary {
    background: var(--accent);
    color: #fff;
  }
  .btn--primary:hover {
    opacity: 0.92;
  }
  .btn--line {
    background: transparent;
    color: #fff;
    border-color: rgba(255, 255, 255, 0.45);
  }
  .btn--line:hover {
    border-color: #fff;
  }
  .btn--block {
    width: 100%;
  }

  /* ── HERO ── */
  .hero {
    background:
      radial-gradient(1200px 500px at 80% -10%, rgba(163, 93, 58, 0.28), transparent 60%),
      var(--ink);
    color: #ece5db;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 46px 46px;
    mask-image: linear-gradient(180deg, transparent, #000 30%, #000 70%, transparent);
  }
  .hero__wrap {
    position: relative;
    max-width: 1080px;
    margin: 0 auto;
    padding: 5rem 1.2rem 3.6rem;
  }
  .hero__eyebrow {
    margin: 0 0 1rem;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #d9a985;
  }
  .hero__title {
    margin: 0;
    font-size: clamp(2rem, 6vw, 3.4rem);
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: #fff;
  }
  .hero__title .hl {
    color: var(--accent);
    background: none;
    padding: 0;
  }
  .hero__sub {
    margin: 1.3rem 0 2rem;
    max-width: 40rem;
    font-size: 1.08rem;
    color: #c9c0b4;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }
  .hero__stats {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }
  .hstat {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .hstat__num {
    font-size: clamp(1.4rem, 3.6vw, 2rem);
    font-weight: 800;
    color: #fff;
    letter-spacing: -0.02em;
  }
  .hstat__label {
    font-size: 0.8rem;
    color: #a89f92;
    line-height: 1.35;
  }

  /* ── 사업분야 ── */
  .biz-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .biz {
    display: block;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.5rem 1.3rem;
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s;
  }
  .biz__go {
    display: inline-block;
    margin-top: 0.9rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent);
  }
  .biz:hover {
    transform: translateY(-3px);

---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { COMPANY } from '../../consts';
import { getConsult, maskName, fmtDate } from '../../lib/consults';

const c = await getConsult(Astro.params.id || '');
if (!c) return Astro.redirect('/consult', 302);

Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<BaseLayout title="상담글 보기 | 상담게시판" description={`${COMPANY.brandName} 상담게시판 비밀글`} wide={true}>

  <section class="cv">
    <p class="crumb"><a href="/">홈</a> <span>/</span> <a href="/consult">상담게시판</a></p>

    <header class="cv__head">
      <span class:list={['st', { 'is-done': c.status === 'done' }]}>{c.status === 'done' ? '답변완료' : '접수'}</span>
      <h1>🔒 {maskName(c.name)} 님의 상담요청</h1>
      <span class="cv__date">{fmtDate(c.created_at)}</span>
    </header>

    <form class="pw" data-pw data-id={c.id}>
      <p>비밀글입니다. 상담 신청 때 입력한 <b>비밀번호</b>를 입력해 주세요.</p>
      <div class="pw__row">
        <input type="password" name="password" required minlength="4" maxlength="20" placeholder="비밀번호" autocomplete="current-password" />
        <button type="submit">확인</button>
      </div>
      <p class="pw__err" data-err hidden></p>
    </form>

    <div class="cv__view" data-view hidden>
      <dl class="cv__info">
        <div><dt>작성자</dt><dd data-f="name"></dd></div>
        <div><dt>공간 유형</dt><dd data-f="space_type"></dd></div>
      </dl>
      <div class="cv__body" data-f="message"></div>

      <div class="reply" data-reply hidden>
        <p class="reply__who">
          <span class="reply__mark">MINAM</span> 미남건축디자인 답변 <span class="reply__date" data-f="replied_at"></span>
        </p>
        <div class="reply__body" data-f="reply"></div>
      </div>
      <p class="wait" data-wait hidden>
        아직 답변이 등록되지 않았습니다. 담당자가 확인 후 연락드리겠습니다. 급하신 경우
        <a href={`tel:${COMPANY.tel}`}>{COMPANY.tel}</a>로 전화 주세요.
      </p>
    </div>

    <p class="cv__back"><a href="/consult">← 목록으로</a></p>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-pw]');
  if (form) {
    const err = form.querySelector<HTMLElement>('[data-err]')!;
    const view = document.querySelector<HTMLElement>('[data-view]')!;
    const set = (k: string, v: string) => {
      const el = view.querySelector<HTMLElement>(`[data-f="${k}"]`);
      if (el) el.textContent = v; // textContent → 손님/관리자 입력을 그대로 글자로만 표시
    };
    const dt = (s: string) =>
      new Date(s).toLocaleString('ko-KR', { timeZone: 'Asia/Seoul', dateStyle: 'medium', timeStyle: 'short' });
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      err.hidden = true;
      const fd = new FormData(form);
      fd.set('id', form.dataset.id || '');
      const btn = form.querySelector('button')!;
      btn.disabled = true;
      try {
        const res = await fetch('/api/consult-view', { method: 'POST', body: fd });
        const d = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(d.error || `오류 (${res.status})`);
        set('name', d.name);
        set('space_type', d.space_type || '-');
        set('message', d.message || '(내용 없음)');
        if (d.reply) {
          set('reply', d.reply);
          set('replied_at', d.replied_at ? dt(d.replied_at) : '');
          view.querySelector<HTMLElement>('[data-reply]')!.hidden = false;
        } else {
          view.querySelector<HTMLElement>('[data-wait]')!.hidden = false;
        }
        form.hidden = true;
        view.hidden = false;
      } catch (e2) {
        err.textContent = (e2 as Error).message;
        err.hidden = false;
        btn.disabled = false;
      }
    });
  }
</script>

<style>
  .cv {
    max-width: 820px;
    margin: 0 auto;
    padding: 2.2rem 1.2rem 3.5rem;
  }
  .crumb {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0 0 1.2rem;
  }
  .crumb a {
    color: var(--muted);
    text-decoration: none;
  }
  .crumb span {
    margin: 0 0.35rem;
    opacity: 0.5;
  }
  .cv__head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem 0.8rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--ink);
  }
  .cv__head h1 {
    margin: 0;
    font-size: 1.35rem;
    flex: 1;
  }
  .cv__date {
    color: var(--muted);
    font-size: 0.88rem;
  }
  .st {
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: #eee;
    color: #777;
  }
  .st.is-done {
    background: var(--accent-soft);
    color: var(--accent);
  }
  .pw {
    margin: 2rem 0;
    padding: 1.6rem;
    border-radius: 14px;
    background: var(--bg-soft);
    text-align: center;
  }
  .pw p {
    margin: 0 0 1rem;
  }
  .pw__row {
    display: flex;
    gap: 0.5rem;
    max-width: 360px;
    margin: 0 auto;
  }
  .pw input {
    flex: 1;
    min-width: 0;
    border: 1px solid var(--border);
    border-radius: 9px;
    padding: 0.65rem 0.8rem;
    font: inherit;
    background: #fff;
  }
  .pw button {
    border: 0;
    border-radius: 9px;
    padding: 0 1.3rem;
    background: var(--accent);
    color: #fff;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .pw__err {
    color: #b23b3b;
    font-weight: 600;
    font-size: 0.9rem;
    margin: 0.9rem 0 0 !important;
  }
  .cv__view {
    margin-top: 1.4rem;
  }
  .cv__info {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 2rem;
    margin: 0 0 1rem;
  }
  .cv__info div {
    display: flex;
    gap: 0.6rem;
  }
  .cv__info dt {
    color: var(--muted);
    font-weight: 700;
    font-size: 0.88rem;
  }
  .cv__info dd {
    margin: 0;
    font-weight: 600;
  }
  .cv__body,
  .reply__body {
    white-space: pre-line;
    line-height: 1.8;
  }
  .cv__body {
    min-height: 4rem;
    padding-bottom: 1.6rem;
    border-bottom: 1px solid var(--border);
  }
  .reply {
    margin-top: 1.4rem;
    padding: 1.3rem 1.4rem;
    border-radius: 14px;
    background: var(--accent-soft);
    border-left: 4px solid var(--accent);
  }
  .reply__who {
    margin: 0 0 0.6rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .reply__mark {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--accent);
    border: 1.5px solid var(--accent);
    border-radius: 5px;
    padding: 0.05rem 0.35rem;
  }
  .reply__date {
    font-weight: 500;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .wait {
    margin-top: 1.4rem;
    padding: 1rem 1.2rem;
    border-radius: 12px;
    background: var(--bg-soft);
    color: var(--muted);
    font-size: 0.92rem;
  }
  .wait a {
    color: var(--accent);
    font-weight: 700;
  }
  .cv__back {
    margin-top: 2rem;
  }
  .cv__back a {
    color: var(--fg);
    text-decoration: none;
    font-weight: 600;
  }
  .cv__back a:hover {
    color: var(--accent);
  }
</style>

---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConsultForm from '../../components/ConsultForm.astro';
import { COMPANY } from '../../consts';
import { listPublic, maskName, fmtDate } from '../../lib/consults';

const PER_PAGE = 15;
const page = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10) || 1);
const { items, total } = await listPublic(page, PER_PAGE);
const pages = Math.max(1, Math.ceil(total / PER_PAGE));
const startNo = total - (page - 1) * PER_PAGE;

Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<BaseLayout
  title="상담게시판"
  description={`${COMPANY.brandName} 상담게시판 — 실내건축·리모델링·전기공사 상담을 남기시면 담당자가 답글로 안내해 드립니다.`}
  wide={true}
>
  <section class="chero">
    <div class="chero__wrap">
      <p class="crumb"><a href="/">홈</a> <span>/</span> 상담게시판</p>
      <p class="chero__eyebrow">CONSULTING</p>
      <h1 class="chero__title">상담게시판</h1>
      <p class="chero__lead">
        상담요청을 남겨 주시면 담당자가 확인 후 연락드리고 답글로 안내해 드립니다. 모든 글은 비밀글로,
        작성 시 정한 비밀번호로만 열람할 수 있습니다.
      </p>
    </div>
  </section>

  <section class="csec">
    <div class="cwrap">
      <div class="board">
        <div class="board__head">
          <h2>상담 목록 <span>총 {total}건</span></h2>
          <a href="#write" class="board__write">✏️ 상담 요청하기</a>
        </div>
        {
          items.length === 0 ? (
            <p class="board__empty">아직 등록된 상담이 없습니다. 첫 상담을 남겨 주세요.</p>
          ) : (
            <ul class="board__list">
              {items.map((c, i) => (
                <li>
                  <a href={`/consult/${c.id}`} class="brow">
                    <span class="brow__no">{startNo - i}</span>
                    <span class="brow__title">
                      🔒 {maskName(c.name)} 님의 상담요청
                      {c.space_type && <em>{c.space_type}</em>}
                    </span>
                    <span class:list={['brow__st', { 'is-done': c.status === 'done' }]}>
                      {c.status === 'done' ? '답변완료' : '접수'}
                    </span>
                    <span class="brow__date">{fmtDate(c.created_at)}</span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
        {
          pages > 1 && (
            <nav class="pager" aria-label="페이지">
              {Array.from({ length: pages }, (_, i) => i + 1).map((n) =>
                n === page ? <span class="is-on">{n}</span> : <a href={n === 1 ? '/consult' : `/consult?page=${n}`}>{n}</a>
              )}
            </nav>
          )
        }
      </div>

      <div class="write" id="write">
        <h2>상담 요청하기</h2>
        <p class="write__lead">
          급하신 경우 <a href={`tel:${COMPANY.tel}`}>{COMPANY.tel}</a>로 전화 주시면 바로 상담해 드립니다.
        </p>
        <ConsultForm />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .chero {
    background:
      radial-gradient(900px 400px at 85% -20%, rgba(163, 93, 58, 0.3), transparent 60%),
      var(--ink);
    color: #ece5db;
  }
  .chero__wrap,
  .cwrap {
    max-width: 1080px;
    margin: 0 auto;
    padding: 2.2rem 1.2rem 2.4rem;
  }
  .crumb {
    font-size: 0.85rem;
    color: #a89f92;
    margin: 0 0 1rem;
  }
  .crumb a {
    color: #cdc3b4;
    text-decoration: none;
  }
  .crumb span {
    margin: 0 0.35rem;
    opacity: 0.5;
  }
  .chero__eyebrow {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 700;
    color: #d9a985;
    letter-spacing: 0.12em;
  }
  .chero__title {
    margin: 0.3rem 0 0.5rem;
    font-size: clamp(1.8rem, 5vw, 2.4rem);
    color: #fff;
    letter-spacing: -0.02em;
  }
  .chero__lead {
    margin: 0;
    color: #cdc3b4;
    max-width: 44rem;
    font-size: 0.98rem;
  }
  .cwrap {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 2rem;
    align-items: start;
  }
  .board__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.6rem;
  }
  .board__head h2,
  .write h2 {
    margin: 0;
    font-size: 1.2rem;
  }
  .board__head h2 span {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--muted);
    margin-left: 0.3rem;
  }
  .board__write {
    display: none;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-weight: 700;
    font-size: 0.88rem;
    text-decoration: none;
  }
  .board__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--ink);
  }
  .board__list li {
    border-bottom: 1px solid var(--border);
  }
  .brow {
    display: grid;
    grid-template-columns: 3rem 1fr auto 6rem;
    gap: 0.8rem;
    align-items: center;
    padding: 0.85rem 0.4rem;
    color: var(--fg);
    text-decoration: none;
  }
  .brow:hover {
    background: var(--bg-soft);
  }
  .brow__no {
    text-align: center;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .brow__title {
    font-weight: 600;
    min-width: 0;
  }
  .brow__title em {
    font-style: normal;
    font-weight: 500;
    font-size: 0.8rem;
    color: var(--muted);
    margin-left: 0.4rem;
  }
  .brow__st {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: #eee;
    color: #777;
    white-space: nowrap;
  }
  .brow__st.is-done {
    background: var(--accent-soft);
    color: var(--accent);
  }
  .brow__date {
    font-size: 0.82rem;
    color: var(--muted);
    text-align: right;
  }
  .board__empty {
    color: var(--muted);
    padding: 2rem 0;
    border-top: 2px solid var(--ink);
    margin: 0;
  }
  .pager {
    display: flex;
    justify-content: center;
    gap: 0.35rem;
    margin-top: 1.4rem;
    flex-wrap: wrap;
  }
  .pager a,
  .pager span {
    min-width: 2.2rem;
    padding: 0.35rem 0.6rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    text-align: center;
    text-decoration: none;
    color: var(--fg);
    font-size: 0.88rem;
  }
  .pager .is-on {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .write {
    scroll-margin-top: 90px;
  }
  .write__lead {
    margin: 0.3rem 0 0.9rem;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .write__lead a {
    color: var(--accent);
    font-weight: 700;
  }
  @media (max-width: 900px) {
    .cwrap {
      grid-template-columns: 1fr;
    }
    .board__write {
      display: inline-block;
    }
  }
  @media (max-width: 520px) {
    .brow {
      grid-template-columns: 1fr auto;
      gap: 0.2rem 0.6rem;
    }
    .brow__no {
      display: none;
    }
    .brow__date {
      grid-column: 1;
      text-align: left;
    }
  }
</style>

---
import { NAV, COMPANY } from '../consts';
import Logo from './Logo.astro';

interface Props {
  /** true 이면 로고 옆 상호·슬로건 문구를 숨김 (페이지 배너에 따로 표시하는 경우) */
  hideBrandText?: boolean;
}
const { hideBrandText = false } = Astro.props;
---

<header class="site-header">
  <div class="bar">
    <a href="/" class="brand" aria-label="미남건축디자인 홈">
      <Logo class="brand-logo" height={46} />
      {!hideBrandText && (
        <span class="brand-text">
          <span class="brand-name">미남건축디자인</span>
          <span class="brand-sub">실내건축 · 전기공사 전문시공</span>
        </span>
      )}
    </a>

    <nav class="nav" aria-label="주요 메뉴">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                {...(item.href === '/consult' ? { 'data-consult-nav': '' } : {})}
                {...('external' in item && item.external
                  ? { target: '_blank', rel: 'noopener' }
                  : {})}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href={`tel:${COMPANY.tel}`} class="cta">
      <span class="cta-ic">☎</span><span class="cta-num">{COMPANY.tel}</span>
    </a>
  </div>
</header>

<script>
  // 관리자로 로그인했던 브라우저에서만: 상담문의 메뉴에 새 상담 개수 말풍선
  if (document.cookie.split('; ').some((c) => c === 'minam_admin_ui=1')) {
    fetch('/api/consult-count', { cache: 'no-store', credentials: 'same-origin' })
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => {
        if (!d || !d.count) return;
        document.querySelectorAll<HTMLAnchorElement>('[data-consult-nav]').forEach((a) => {
          const b = document.createElement('a');
          b.href = '/admin/consults?f=new';
          b.className = 'consult-bubble';
          b.title = `답변 대기 상담 ${d.count}건 — 관리자 화면으로`;
          b.textContent = `💬 ${d.count}`;
          a.parentElement!.style.position = 'relative';
          a.parentElement!.appendChild(b);
        });
      })
      .catch(() => {});
  }
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 30;
  }
  .bar {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0.6rem 1.2rem 0.35rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 1rem;
  }
  /* PC: 로고 · 메뉴 · 전화 한 줄 */
  @media (min-width: 900px) {
    .bar {
      padding: 0.55rem 1.2rem;
    }
    .bar .nav {
      order: 0;
      flex: 1;
      width: auto;
      margin: 0;
      overflow: visible;
    }
    .bar .nav ul {
      margin: 0 auto;
      padding: 0;
    }
  }
  /* 브랜드 */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--fg);
    text-decoration: none;
    white-space: nowrap;
  }
  .brand-logo {
    display: block;
    height: 46px;
    width: auto;
  }
  @media (max-width: 480px) {
    .brand-logo {
      height: 40px;
    }
  }
  .brand-text {
    padding-left: 0.7rem;
    border-left: 1px solid var(--border);
  }
  :global(.consult-bubble) {
    position: absolute;
    top: -0.45rem;
    right: -0.5rem;
    background: #e5484d;
    color: #fff !important;
    font-size: 0.7rem;
    font-weight: 800;
    line-height: 1;
    padding: 0.25rem 0.42rem;
    border-radius: 999px 999px 999px 3px;
    text-decoration: none;
    box-shadow: 0 2px 6px rgba(229, 72, 77, 0.35);
    animation: bubble-pop 1.8s ease-in-out infinite;
  }
  @keyframes bubble-pop {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-2px); }
  }
  .brand-mark {
    font-weight: 800;
    letter-spacing: 0.18em;
    font-size: 1.05rem;
    color: var(--accent);
    border: 1.5px solid var(--accent);
    padding: 0.18rem 0.4rem 0.14rem 0.5rem;
    border-radius: 6px;
    line-height: 1;
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .brand-name {
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
  }
  .brand-sub {
    font-size: 0.72rem;
    color: var(--muted);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  /* 전화 CTA */
  .cta {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--accent);
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
  }
  .cta:hover {
    opacity: 0.92;
  }
  /* 내비게이션 — 한 줄 가로 스크롤 */
  .nav {
    order: 3;
    width: calc(100% + 2.4rem);
    margin: 0 -1.2rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .nav::-webkit-scrollbar {
    display: none;
  }
  .nav ul {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.1rem;
    list-style: none;
    margin: 0;
    padding: 0.5rem 1.2rem 0.5rem;
    width: max-content;
  }
  .nav li {
    flex: 0 0 auto;
  }
  .nav a {
    display: inline-block;
    padding: 0.4rem 0.7rem;
    border-radius: 6px;
    color: var(--fg);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .nav a:hover {
    background: var(--accent-soft);
    color: var(--accent);
  }

  @media (max-width: 720px) {
    .brand-sub {
      display: none;
    }
    .brand-text {
      display: none;
    }
  }
  /* 휴대폰: 로고와 전화 버튼이 한 줄에 들어가도록 */
  @media (max-width: 480px) {
    .bar {
      column-gap: 0.5rem;
    }
    .brand {
      gap: 0.45rem;
    }
    .brand-mark {
      letter-spacing: 0.12em;
      font-size: 0.95rem;
    }
    .brand-name {
      font-size: 1rem;
    }
    .cta {
      padding: 0.45rem 0.75rem;
      font-size: 0.88rem;
    }
  }
</style>

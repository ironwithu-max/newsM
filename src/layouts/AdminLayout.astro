---
// 관리자 화면 공통 레이아웃 (/admin/*) — 검색엔진 비노출
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | 미남건축디자인 관리자</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@latest/dist/web/variable/pretendardvariable-dynamic-subset.css"
    />
  </head>
  <body>
    <div class="topbar">
      <a href="/admin/works" class="topbar__brand"><span class="mark">MINAM</span><b>시공사례 관리</b></a>
      <a href="/works" target="_blank" rel="noopener">사이트 보기 →</a>
    </div>
    <main class="wrap">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f6f3ee;
    --card: #fff;
    --fg: #211d1a;
    --muted: #726a5f;
    --border: #e7e1d7;
    --accent: #a35d3a;
    --accent-soft: #f5ebe2;
    --ink: #1c1917;
    --danger: #b23b3b;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: 'Pretendard Variable', 'Pretendard', -apple-system, 'Malgun Gothic', sans-serif;
    background: var(--bg);
    color: var(--fg);
    line-height: 1.6;
  }
  .topbar {
    background: var(--ink);
    color: #fff;
    padding: 0.9rem 1.2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .topbar a { color: #cdc3b4; text-decoration: none; font-size: 0.9rem; }
  .topbar a:hover { color: #fff; }
  .topbar__brand { color: #fff !important; font-size: 1rem !important; }
  .topbar b { font-weight: 800; }
  .mark {
    border: 1.5px solid var(--accent);
    color: var(--accent);
    font-weight: 800;
    letter-spacing: 0.15em;
    padding: 0.15rem 0.4rem;
    border-radius: 6px;
    margin-right: 0.5rem;
    font-size: 0.85rem;
  }
  .wrap { max-width: 1040px; margin: 0 auto; padding: 1.4rem 1.2rem 3rem; }
  h1 { font-size: 1.3rem; margin: 0.4rem 0 1rem; }
  .head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .warn, .ok {
    border-radius: 10px;
    padding: 0.9rem 1.1rem;
    font-size: 0.92rem;
    margin-bottom: 1.2rem;
  }
  .warn { background: #fff4e5; border: 1px solid #f0c98a; color: #8a5a1a; }
  .ok { background: #eef7ef; border: 1px solid #b9dcbc; color: #2f6b35; }
  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.3rem 1.4rem;
    margin-bottom: 1.6rem;
  }
  label { display: block; font-size: 0.85rem; font-weight: 700; margin-bottom: 0.35rem; }
  input, select, textarea {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: 9px;
    padding: 0.6rem 0.75rem;
    font: inherit;
    color: var(--fg);
    background: #fff;
  }
  textarea { min-height: 220px; resize: vertical; line-height: 1.7; }
  input:focus, select:focus, textarea:focus { outline: 2px solid var(--accent-soft); border-color: var(--accent); }
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.3rem;
    background: var(--accent); color: #fff; border: 1px solid var(--accent); cursor: pointer;
    font: inherit; font-weight: 700; font-size: 0.95rem; padding: 0.65rem 1.3rem; border-radius: 999px;
    text-decoration: none; white-space: nowrap;
  }
  .btn:hover { opacity: 0.92; }
  .btn:disabled { opacity: 0.5; cursor: wait; }
  .btn--sm { padding: 0.35rem 0.75rem; font-size: 0.82rem; border-radius: 8px; }
  .btn--line { background: #fff; color: var(--fg); border-color: var(--border); }
  .btn--danger { background: #fff; color: var(--danger); border-color: #e6c4c4; }
  .btn--danger:hover { background: #fbeaea; }
  .muted { color: var(--muted); font-size: 0.9rem; }
</style>
